  openingPanels:
  - art: {fileID: 0}
    caption: Goli spots his friends having a picnic across the pond.
    voiceKey: m4_story_open_1
    restPosition: {x: -430, y: 170}
    restRotation: -4
    restScale: 1
    fromOffset: {x: 0, y: 900}
    fromRotation: -18
    hold: 2.5
  - art: {fileID: 0}
    caption: But there is no path around the pond!
    voiceKey: m4_story_open_2
    restPosition: {x: 150, y: 235}
    restRotation: 5
    restScale: 1
    fromOffset: {x: 0, y: 900}
    fromRotation: -18
    hold: 2.5
  - art: {fileID: 0}
    caption: Help Goli build a bridge to the picnic!
    voiceKey: m4_story_open_3
    restPosition: {x: -190, y: -190}
    restRotation: 3
    restScale: 1
    fromOffset: {x: 0, y: 900}
    fromRotation: -18
    hold: 2.5
  endingPanels:
  - art: {fileID: 0}
    caption: The bridge is finished!
    voiceKey: m4_story_end_1
